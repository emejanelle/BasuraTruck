<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_horizontal"
    android:background="#F1F0E9"
    android:backgroundTint="#F1F0E9"
    android:orientation="vertical">

    <TextView
        android:id="@+id/aboutTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:fontFamily="@font/inria_serif_bold"
        android:text="WELCOME"
        android:textAlignment="center"
        android:textColor="#0D4715"
        android:textSize="35sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="238dp"
        android:layout_height="204dp"
        android:layout_gravity="center_horizontal"
        app:srcCompat="@drawable/logo" />

    <TextView
        android:id="@+id/wlcmtext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/inria_serif_light"
        android:padding="20dp"
        android:text="Welcome to Basura Track! Your one tap basura app. "
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wlcmmssge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/inria_sans"
        android:padding="15dp"
        android:text="Help us keep the environment clean and green by collecting your garbage with us. You can easily schedule pick-ups based on your location."
        android:textAlignment="center"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnGetStarted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="90dp"
        android:onClick="fragment_home"
        android:backgroundTint="#0D4715"
        android:padding="15dp"
        android:text="GET STARTED" />

    <Button
        android:id="@+id/btnLearnMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="5dp"
        android:onClick="fragment_about"
        android:padding="15dp"
        android:text="LEARN MORE"
        app:strokeColor="#0D4715" />
</LinearLayout>