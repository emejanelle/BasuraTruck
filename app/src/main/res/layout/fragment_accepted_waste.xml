<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".aboutfrgmnt"
    android:background="#F1F0E9"
    android:backgroundTint="#F1F0E9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/garbageTruckImage"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/truck"
            android:layout_marginTop="50dp"
            android:contentDescription="Garbage Truck"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WE ACCEPT THESE WASTE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:textColor="#4CAF50"
            android:layout_gravity="center_horizontal"/>

        <LinearLayout
            android:id="@+id/wasteList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="3dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/solidwaste"
                    android:contentDescription="Information Icon"
                    android:layout_gravity="center_vertical"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/solidW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inria_serif_light"
                    android:paddingStart="10dp"
                    android:text="SOLID WASTE"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="3dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/construction"
                    android:contentDescription="Information Icon"
                    android:layout_gravity="center_vertical"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/constW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inria_serif_light"
                    android:paddingStart="10dp"
                    android:paddingBottom="8dp"
                    android:text="CONSTRUCTION WASTE"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="3dp">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Information Icon"
                    android:paddingBottom="8dp"
                    android:src="@drawable/bulkywaste" />

                <TextView
                    android:id="@+id/bulkyW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inria_serif_light"
                    android:paddingStart="10dp"
                    android:text="BULKY WASTE"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="3dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/foodwaste"
                    android:contentDescription="Information Icon"
                    android:layout_gravity="center_vertical"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/foodW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inria_serif_light"
                    android:paddingStart="10dp"
                    android:text="FOOD WASTE"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="3dp">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/recycle"
                    android:contentDescription="Information Icon"
                    android:layout_gravity="center_vertical"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/recyclableW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inria_serif_light"
                    android:paddingStart="10dp"
                    android:paddingBottom="8dp"
                    android:text="RECYCLABLE WASTE"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>